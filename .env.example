# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SUPABASE POSTGRESQL & STORAGE (PERSISTÊNCIA REAL DA BASE DE DADOS)
# ==============================================================================
# Obtenha estas credenciais no painel do seu projecto Supabase (https://supabase.com):
# 1. Project Settings -> API -> Project URL
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"

# 2. Project Settings -> API -> Project API keys -> anon / public key (usado no cliente ou requisições públicas)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Project Settings -> API -> Project API keys -> service_role key (SECRETA: apenas no servidor, nunca no cliente!)
# Utilizada pelo backend para migrações, validação de comprovativos e bypass controlado de RLS para administradores.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ==============================================================================
# SEGURANÇA E REGISTO DO PRIMEIRO ADMINISTRADOR
# ==============================================================================
# Token único de configuração para autorizar o registo seguro da primeira conta
# de administrador (ex: antoniethantonio@gmail.com).
# Este valor é mantido privadamente no servidor. Uma vez registado o primeiro
# administrador, o endpoint é permanentemente bloqueado contra novas criações.
ADMIN_SETUP_TOKEN="mocinhas-segredo-admin-2026-super-forte"
